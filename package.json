{
  "name": "code_zhuan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run typecheck:server && vite build",
    "typecheck": "vue-tsc -b",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "check": "npm run test && npm run build && npm run db:check",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:push": "drizzle-kit push",
    "db:verify": "tsx scripts/verify-database-schema.ts",
    "db:audit:quote-history": "tsx scripts/audit-quote-history.ts",
    "smoke:data": "tsx scripts/smoke-market-data.ts",
    "smoke:data:no-persist": "tsx scripts/smoke-market-data.ts --no-persist",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.2",
    "pg": "^8.20.0",
    "vue": "^3.5.32",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "@vercel/node": "^5.7.5",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "ws": "^8.21.0"
  }
}
